ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Calendar OAuth 2.0
# 1. Acesse /auth/google no browser para iniciar o fluxo
# 2. Após autorizar, copie o GOOGLE_REFRESH_TOKEN exibido na tela e adicione ao Railway
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://romatecvoiceagent-production.up.railway.app/auth/google/callback

# Banco de dados MySQL (Railway)
# ZAYRA compartilha o MESMO MySQL que o Romatec_CRM_WhatsApp — leitura direta
# de leadQualifications/campaigns/messages desde v1.6.0 (sem mais HTTP no CRM).
DATABASE_URL=mysql://user:password@host:port/database

# AvalieImob (FastAPI + JWT auto-renovável desde v1.7.0)
# ZAYRA loga automaticamente via POST /api/auth/login com email+senha do CEO
# e cacheia o JWT por ~6 dias (margem sob os 168h de validade do token).
# Conta precisa ter ASSINATURA ATIVA (mensal/trimestral/anual) — endpoints
# protegidos por get_active_subscriber retornam 403 se a assinatura expirou.
AVALIEIMOB_BASE_URL=https://www.romatecavalieimob.com.br
AVALIEIMOB_EMAIL=
AVALIEIMOB_PASSWORD=

# WhatsApp — CEO (número com DDI+DDD, sem espaços ou traços)
# Exemplo: 5598999887766
CEO_WHATSAPP_PHONE=

# Z-API — provedor WhatsApp (v1.8.5+)
# Mesmas credenciais que o Romatec_CRM_WhatsApp usa.
# ZAYRA chama Z-API direto (sem passar pelo CRM) desde v1.8.5.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io

# ── Telegram (v1.9.0+) ──────────────────────────────────────────────────────
# Bot dedicado pra ZAYRA — separado do bot do CRM. Setup:
#   1. @BotFather no Telegram → /newbot → nome (ex: Zayra Romatec) → username
#   2. Copia o TOKEN que ele dá → cola em TELEGRAM_BOT_TOKEN no Railway
#   3. Mande /start pro @userinfobot pra descobrir seu chat_id
#   4. Adicione seu chat_id em TELEGRAM_AUTHORIZED_USER_IDS (vazio = bloqueia tudo)
#   5. Acesse /auth/telegram/setup no browser pra registrar o webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_IDS=  # comma-separated, ex: 123456789,987654321
TELEGRAM_BOT_USERNAME=          # opcional, só pra docs

# Horário do briefing diário automático (fuso de Fortaleza / BRT)
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# Equipe Romatec (JSON array) — configure no Railway para delegar tarefas
# Formato: [{"nome":"Fulano","cargo":"Corretor","telefone":"5598999887766"}]
TEAM_JSON=

# ── Cascata de IA (v1.25.0+) — Cerebras → Gemini → Claude ──────────────────
# A v1.25.0 introduziu cascata automática de providers de IA pra resolver o
# erro 413 "Request too large" que o Groq estourava no free tier (TPM 12k).
# Ordem: Cerebras (rápido, 30k TPM) → Gemini (1M TPM) → Claude (último elo).
# Cada provider faz seu próprio tool calling. Se um cair, o próximo assume
# automaticamente. Logs mostram qual respondeu: "[AI] ✅ Cerebras llama-3.3-70b".
#
# Cerebras Cloud (https://cloud.cerebras.ai) — free tier generoso, mesmo modelo Groq
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
#
# Gemini (https://aistudio.google.com/apikey) — free 1M TPM, vision suportado
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
#
# Claude — fallback final + auto-titulação de sessões + análise multimodal
# (ANTHROPIC_API_KEY já está no topo deste arquivo)
CLAUDE_FALLBACK_MODEL=claude-sonnet-4-5
#
# Limites do orquestrador
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_TOKENS_INPUT=8000
AI_MAX_TOKENS_OUTPUT=1024

# ── Groq — APENAS transcrição de voz (Whisper) desde v1.25.0 ───────────────
# O chat/raciocínio migrou pra cascata acima. Groq fica só pro Whisper no /voice.
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Spotify (v1.8.0+) — controle de playback do CEO ─────────────────────────
# 1. Cria app em https://developer.spotify.com/dashboard
# 2. Redirect URI: https://romatecvoiceagent-production.up.railway.app/auth/spotify/callback
# 3. Adiciona CLIENT_ID e CLIENT_SECRET no Railway
# 4. Acessa /auth/spotify no navegador, autoriza com a conta Premium do CEO
# 5. Página retorna SPOTIFY_REFRESH_TOKEN — cola no Railway
# Pré-requisito: conta Spotify Premium (free tier não permite tocar/pausar)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=https://romatecvoiceagent-production.up.railway.app/auth/spotify/callback

# ── Filesystem autônomo (v1.14.0+) ──────────────────────────────────────────
# Lista de diretórios separados por ";" que ZAYRA pode ler/escrever via tools
# fs_listar, fs_ler, fs_escrever, fs_buscar, fs_apagar.
# Tudo fora dessas raízes retorna "acesso negado".
# Em produção (Railway): use FS_ALLOWED_ROOTS=/app pra liberar o próprio código.
# Em dev local (Windows): pode listar pastas reais (RomatecVoiceAgent, CRM, AvalieImob, ObsidianVaults).
# Se ausente, default = cwd + 4 pastas Romatec do CEO.
FS_ALLOWED_ROOTS=

# ── Alarmes nativos iPhone (v1.24.0+) ───────────────────────────────────────
# Disparo de alarme nativo iOS via ntfy.sh + Atalho "ZAYRA-Alarme".
# 1. Escolha um tópico secreto e único (qualquer string difícil de adivinhar).
# 2. CEO instala app "ntfy" da App Store, assina esse tópico.
# 3. CEO cria Atalho "ZAYRA-Alarme" no app Atalhos:
#    - Obter texto da entrada → Obter dicionário do texto
#    - Obter valor da chave 'datetime' → Obter data formatada (ISO 8601)
#    - Criar alarme com horário acima e etiqueta = chave 'titulo'
# 4. No app ntfy → tópico → ativar "Abrir Click ao tocar"
IOS_NTFY_TOPIC=zayra-romatec-TROCAR-POR-ALGO-SECRETO
IOS_NTFY_BASE=https://ntfy.sh

PORT=3000
