ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Calendar OAuth 2.0
# 1. Acesse /auth/google no browser para iniciar o fluxo
# 2. Após autorizar, copie o GOOGLE_REFRESH_TOKEN exibido na tela e adicione ao Railway
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://romatecvoiceagent.railway.app/auth/google/callback

# Banco de dados MySQL (Railway)
DATABASE_URL=mysql://user:password@host:port/database

# CRM WhatsApp Romatec
# Se retornar erro HTML, verifique se a URL aponta para o backend e não para o frontend
CRM_BASE_URL=https://romateccrm.com.br
CRM_API_KEY=

# AvalieImob
# Se retornar 401, gere um novo token no painel do AvalieImob e atualize aqui
AVALIEIMOB_BASE_URL=https://www.romatecavalieimob.com.br
AVALIEIMOB_API_KEY=

# WhatsApp — CEO (número com DDI+DDD, sem espaços ou traços)
# Exemplo: 5598999887766
CEO_WHATSAPP_PHONE=

# Horário do briefing diário automático (fuso de Fortaleza / BRT)
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# Equipe Romatec (JSON array) — configure no Railway para delegar tarefas
# Formato: [{"nome":"Fulano","cargo":"Corretor","telefone":"5598999887766"}]
TEAM_JSON=

# ── Groq — Transcrição de Voz Ultra-Rápida ───────────────────────────────────
# Groq usa hardware LPU para transcrição ~10x mais rápida que OpenAI Whisper
# Obtenha em: https://console.groq.com/keys
# Com GROQ_API_KEY: voz é transcrita pelo Groq Whisper (rápido)
# Claude continua sendo usado para raciocínio (inteligente)
# → Os dois trabalham juntos: Groq (velocidade) + Claude (inteligência)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

PORT=3000
