{
  "name": "romatec-voice-agent",
  "version": "3.4.2",
  "description": "Roma — Assistente executivo de voz da Romatec Consultoria Imobiliária",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/public dist/public",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rag:ingest-folder": "tsx src/scripts/ragIngestFolder.ts",
    "rag:ingest-obsidian": "tsx src/scripts/ragIngestObsidian.ts",
    "contracts:ingest": "tsx src/scripts/contractsIngestFile.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "@google/generative-ai": "^0.24.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@supabase/supabase-js": "^2.105.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/proj4": "^2.5.6",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.8.4",
    "docx": "^9.6.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "googleapis": "^171.4.0",
    "mammoth": "^1.12.0",
    "msedge-tts": "^1.3.4",
    "multer": "^2.1.1",
    "mysql2": "^3.22.2",
    "node-forge": "^1.4.0",
    "openai": "^4.96.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "proj4": "^2.20.8",
    "qrcode": "^1.5.4",
    "shapefile": "^0.6.6",
    "voyageai": "^0.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/node-forge": "^1.3.14",
